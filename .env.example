NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Tidak diperlukan oleh uploader signed URL; disediakan untuk tes RLS live.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=http://127.0.0.1:3000
CODE_HMAC_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RATE_LIMIT_HMAC_SECRET=YOUR_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# 32 byte, base64 standar. Buat dengan crypto.randomBytes(32).toString('base64').
TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY
CLEANUP_SECRET=YOUR_DEDICATED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
USAGE_PERIOD_START=YOUR_ISO_8601_USAGE_CYCLE_START
# vercel: memakai x-vercel-forwarded-for; local: satu bucket IP bersama.
TRUSTED_PROXY=local
ENABLE_LIVE_TESTS=false
